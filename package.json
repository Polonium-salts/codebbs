{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "cross-env NODE_ENV=production node server.js",
    "lint": "next lint",
    "generate-pwa-icons": "node scripts/generate-pwa-icons.js",
    "analyze-db": "node scripts/analyze-db.js",
    "backup-db": "node -e \"require('fs').mkdirSync('./backups', { recursive: true }); require('fs').copyFileSync('./prisma/dev.db', './backups/backup-' + new Date().toISOString().replace(/[:.]/g, '-') + '.db'); console.log('数据库已备份到 backups 目录')\""
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "@octokit/core": "^5.2.0",
    "@prisma/client": "^6.5.0",
    "@radix-ui/react-tabs": "^1.1.3",
    "bcryptjs": "^3.0.2",
    "critters": "^0.0.23",
    "date-fns": "^3.6.0",
    "emoji-mart": "^5.6.0",
    "framer-motion": "^12.5.0",
    "lru-cache": "^9.1.2",
    "lucide-react": "^0.482.0",
    "next": "^14.0.0",
    "next-auth": "^4.24.5",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.5.2",
    "socket.io": "^4.8.1",
